# indlela-api (Sail): APP_PORT in indlela-api/.env, default 8000.
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="Indlela"

# Local grid maps (Leaflet). OpenStreetMap's public tiles are for development only:
# production should use a commercial tile provider (MapTiler, Stadia, Mapbox…).
# Leave empty for the defaults.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
